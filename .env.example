# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Token của Zalo Bot (bắt buộc từ Task 1.5 khi khởi tạo Notifier)
ZALO_BOT_TOKEN=

# Danh sách chat_id người nhận, ngăn cách bằng dấu phẩy
# Ví dụ: ZALO_CHAT_IDS=id_1,id_2,id_3
ZALO_CHAT_IDS=

# API key dịch vụ lưu ảnh tạm (ImgBB) — chỉ cần nếu Zalo Bot yêu cầu URL ảnh công khai
IMAGE_HOST_API_KEY=
